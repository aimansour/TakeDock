{
  "name": "takedock",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:ui": "vitest run",
    "build": "vite build",
    "format:check": "prettier --check src tests/desktop package.json vite.config.ts tsconfig.json",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --features desktop",
    "desktop:build": "tauri build --features desktop",
    "test:desktop": "pwsh -NoProfile -File scripts/test-desktop.ps1"
  },
  "dependencies": {
    "svelte": "5.57.1",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.6.3",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/globals": "9.31.3",
    "tsx": "4.23.15",
    "extract-zip": "file:./tests/desktop/no-driver-download"
  },
  "overrides": {
    "serialize-javascript": "7.1.2",
    "extract-zip": "$extract-zip"
  }
}
